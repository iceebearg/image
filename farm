-- per-server history, kept in a file so it survives server hops and game restarts
local HISTORY_FILE = "VaultFarm_History.json"
local BAR_COUNT = 24
local history = {}
pcall(function()
    local data = HttpService:JSONDecode(readfile(HISTORY_FILE))
    if type(data) == "table" then history = data end
end)
for _, e in ipairs(history) do
    e.earned = tonumber(e.earned) or 0
    e.seconds = tonumber(e.seconds) or 0
end
local currentEntry = history[#history]
if not currentEntry or currentEntry.id ~= game.JobId then
    currentEntry = {id = game.JobId, earned = 0, seconds = 0, t = os.time()}
    table.insert(history, currentEntry)
    while #history > BAR_COUNT do table.remove(history, 1) end
end
serverValue.Text = "$" .. formatShort(currentEntry.earned)

local function saveHistory()
    if not writefile then return end
    pcall(function() writefile(HISTORY_FILE, HttpService:JSONEncode(history)) end)
end

local function historyRate()
    local earned, seconds = 0, 0
    for _, e in ipairs(history) do
        earned = earned + e.earned
        seconds = seconds + e.seconds
    end
    if seconds < 60 then return nil end
    return earned / (seconds / 3600)
end

-- everything the chart needs lives in this block; only renderChart is used outside it
local renderChart
do
    local function formatDuration(seconds)
        seconds = math.floor(seconds)
        if seconds >= 3600 then return string.format("%dh %dm", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60)) end
        if seconds >= 60 then return string.format("%dm %ds", math.floor(seconds / 60), seconds % 60) end
        return seconds .. "s"
    end

    local function entryAt(i)
        return history[#history - BAR_COUNT + i]
    end

    local chart = glass(dashboard, {Position = UDim2.fromOffset(0, 172), Size = UDim2.new(1, 0, 0, 98)}, nil, 16)
    table.insert(dashCards, {chart, chart.Position})
    label(chart, {
        Position = UDim2.fromOffset(16, 12),
        Size = UDim2.new(0.5, 0, 0, 14),
        Text = "Servers",
        TextSize = 12,
        TextColor3 = Theme.Muted,
    })
    local chartCount = label(chart, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -16, 0, 12),
        Size = UDim2.new(0.5, 0, 0, 14),
        Text = "",
        TextSize = 11,
        TextColor3 = Theme.Dim,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    local barArea = create("Frame", chart, {
        Position = UDim2.fromOffset(16, 34),
        Size = UDim2.new(1, -32, 1, -48),
        BackgroundTransparency = 1,
    })

    local tooltip = create("Frame", chart, {
        AnchorPoint = Vector2.new(0.5, 1),
        Size = UDim2.fromOffset(150, 60),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.02,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10,
    })
    corner(tooltip, 12)
    specular(tooltip, 0.6)
    local tooltipScale = create("UIScale", tooltip, {Scale = 0.9})
    local tipTitle = label(tooltip, {Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 14), TextSize = 11, TextColor3 = Theme.Muted, ZIndex = 11})
    local tipMoney = label(tooltip, {Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -24, 0, 18), FontFace = font(Enum.FontWeight.Bold), TextSize = 15, ZIndex = 11})
    local tipMeta = label(tooltip, {Position = UDim2.fromOffset(12, 41), Size = UDim2.new(1, -24, 0, 12), TextSize = 10, TextColor3 = Theme.Dim, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 11})

    local bars, barHeights = {}, {}
    local hoveredIndex

    local function hideTooltip()
        if not tooltip.Visible then return end
        tween(tooltipScale, 0.12, {Scale = 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Connect(function()
            if not hoveredIndex then tooltip.Visible = false end
        end)
    end

    local function showTooltip(i, instant)
        local e = entryAt(i)
        if not e then
            hideTooltip()
            return
        end
        local isCurrent = e == currentEntry
        tipTitle.Text = isCurrent and "This server" or ("Server #" .. (#history - BAR_COUNT + i))
        tipMoney.Text = "$" .. FormatMoney(math.floor(e.earned))
        tipMoney.TextColor3 = isCurrent and Theme.Green or Theme.Text
        tipMeta.Text = string.sub(tostring(e.id), 1, 8) .. "  ·  " .. formatDuration(e.seconds)

        -- place it above the bar's final height, from sizes only so the reveal animation can't skew it
        local areaSize = barArea.AbsoluteSize
        local x = math.clamp(16 + areaSize.X * (i - 0.5) / BAR_COUNT, 80, chart.AbsoluteSize.X - 80)
        local y = 34 + areaSize.Y * (1 - barHeights[i]) - 6
        local target = UDim2.fromOffset(x, y)
        if not tooltip.Visible then
            tooltip.Position = target + UDim2.fromOffset(0, 6)
            tooltip.Visible = true
            tooltipScale.Scale = 0.9
            tween(tooltipScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
        end
        tween(tooltip, instant and 0 or 0.2, {Position = target})
    end

    function renderChart()
        local maxValue = 0
        for _, e in ipairs(history) do
            if e.earned > maxValue then maxValue = e.earned end
        end
        for i = 1, BAR_COUNT do
            local e = entryAt(i)
            local h = (e and maxValue > 0) and math.max(e.earned / maxValue, 0.08) or 0.08
            barHeights[i] = h
            local color, transparency = Theme.White, 0.92
            if e then
                local isCurrent = e == currentEntry
                color = isCurrent and Theme.Green or Theme.White
                transparency = hoveredIndex == i and 0 or (isCurrent and 0.1 or 0.55)
            end
            tween(bars[i], 0.6, {Size = UDim2.new(1, -4, h, 0), BackgroundColor3 = color, BackgroundTransparency = transparency})
        end
        chartCount.Text = #history == 1 and "1 server" or (#history .. " servers")
        if hoveredIndex then showTooltip(hoveredIndex, true) end
    end

    for i = 1, BAR_COUNT do
        local column = create("Frame", barArea, {
            Position = UDim2.fromScale((i - 1) / BAR_COUNT, 0),
            Size = UDim2.fromScale(1 / BAR_COUNT, 1),
            BackgroundTransparency = 1,
        })
        local bar = create("Frame", column, {
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.fromScale(0.5, 1),
            Size = UDim2.new(1, -4, 0.08, 0),
            BackgroundColor3 = Theme.White,
            BackgroundTransparency = 0.92,
            BorderSizePixel = 0,
        })
        corner(bar, 3)
        bars[i], barHeights[i] = bar, 0.08
        column.MouseEnter:Connect(function()
            hoveredIndex = i
            renderChart()
            showTooltip(i)
        end)
        column.MouseLeave:Connect(function()
            if hoveredIndex ~= i then return end
            hoveredIndex = nil
            renderChart()
            hideTooltip()
        end)
    end
    renderChart()
end

