local animBlockConn, animBlockAnimator
local function setupAnimationBlocker(char)
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
    if not animator then return end
    if animBlockAnimator ~= animator then
        if animBlockConn then animBlockConn:Disconnect() end
        animBlockAnimator = animator
        animBlockConn = animator.AnimationPlayed:Connect(function(track)
            if not running() then
                animBlockConn:Disconnect()
                return
            end
            local n = string.lower(track.Name or "")
            local id = tostring(track.Animation and track.Animation.AnimationId or "")
            if string.find(n, "block") or string.find(n, "guard") or string.find(id, "10479335397") or string.find(id, "10480396650") then
                pcall(function()
                    track:Stop(0)
                    track:Destroy()
                end)
            end
        end)
    end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local n = string.lower(track.Name or "")
        local id = tostring(track.Animation and track.Animation.AnimationId or "")
        if string.find(n, "block") or string.find(n, "guard") or string.find(id, "10479335397") or string.find(id, "10480396650") then 
            pcall(function()
                track:Stop(0)
                track:Destroy()
            end)
        end
    end
end

