-- a single heartbeat drives every sprite sheet, and only while the menu is on screen
table.insert(uiConns, RunService.Heartbeat:Connect(function(dt)
    if not holder.Visible then return end
    for img, s in pairs(sprites) do
        if not img.Parent then
            sprites[img] = nil
        elseif s.playing then
            s.time = s.time + dt
            local frames = s.def.frames or (s.def.cols * s.def.rows)
            local fps = s.loop and (s.def.loopFps or s.def.fps) or s.def.fps
            local step = math.floor(s.time * (fps or 24))
            local frame = step % frames
            -- a one-shot play (a payout) runs `spins` full cycles, then rests on the first frame
            if not s.loop and step >= frames * (s.def.spins or 1) then
                frame, s.playing = 0, false
            end
            if frame ~= s.frame then
                s.frame = frame
                setSpriteFrame(img, s.def, frame)
            end
        end
    end
end))

