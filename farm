local function fpsArrow(glyph, xOffset, delta)
    local b = glass(fpsRow, {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOffset, 0.5, 0),
        Size = UDim2.fromOffset(26, 26),
        BackgroundTransparency = 0.93,
    }, "TextButton", 13)
    label(b, {Size = UDim2.fromScale(1, 1), Text = glyph, FontFace = font(Enum.FontWeight.SemiBold), TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center})
    addPressEffect(b)
    b.MouseButton1Click:Connect(function()
        local nextIndex = math.clamp(fpsIndex + delta, 1, #fpsOptions)
        if nextIndex == fpsIndex then return end
        fpsIndex = nextIndex
        local v = fpsOptions[fpsIndex]
        getgenv().FPSCap = v
        saveConfig()
        renderFps(true)
        if setfpscap then pcall(setfpscap, v > 0 and v or 999) end
    end)
end
