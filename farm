end

local function CollectVaultCash(baseTargetPos)
    setStatus("Picking up cash")
    local collectStartTime = tick()
    while running() do
        if getgenv().FarmPaused then collectStartTime = tick(); task.wait(0.1); continue end
        if (tick() - collectStartTime) > 15 then break end
        if isDead() then return false end
        
        local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        local dropFolder = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Drop")
        if not dropFolder then return false end
        local foundCash = nil
        local closestDist = 9e9
        
        for _, drop in ipairs(dropFolder:GetChildren()) do
            if drop.Name == "MoneyDrop" or string.find(string.lower(drop.Name), "money") or string.find(string.lower(drop.Name), "cash") then
                local cashPart = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
                if cashPart then
                    local dist = (cashPart.Position - baseTargetPos).Magnitude
                    if dist <= 15 and dist < closestDist then
                        closestDist = dist
                        foundCash = drop
                    end
                end
            end
        end
        
        if foundCash then
            local cashPart = foundCash:IsA("BasePart") and foundCash or foundCash:FindFirstChildWhichIsA("BasePart", true)
            if cashPart then
                getgenv().VaultCashAngle = (getgenv().VaultCashAngle or 0) + math.rad(math.random(45, 110))
                local radius = math.random(5, 10)
                local newOffset = Vector3.new(math.cos(getgenv().VaultCashAngle) * radius, math.random(1, 3), math.sin(getgenv().VaultCashAngle) * radius)
                lastVaultCashOffset = newOffset

                local targetPos = cashPart.Position + lastVaultCashOffset
                securePosition(hrp, targetPos, cashPart.Position)
                
                local cd = foundCash:FindFirstChildWhichIsA("ClickDetector", true)
                if cd then pcall(function() safeFireClick(cd) end) end
                pcall(function() safeFireTouch(hrp, cashPart, 0) end)
                task.wait(0.01)
                pcall(function() safeFireTouch(hrp, cashPart, 1) end)
                task.wait(0.15)
            end
        else
            if (tick() - collectStartTime) > 1.5 then break end
        end
        task.wait()
    end
    return true
end

