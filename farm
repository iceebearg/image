local function setupForceReset(char)
    if not char then return end
    setupAnimationBlocker(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    if humanoid.Health <= 1 then return end
    if forceResetConn then pcall(function() forceResetConn:Disconnect() end) end
    forceResetConn = humanoid.HealthChanged:Connect(function(health)
        if not running() then return end
        if getgenv().FarmPaused then return end
        if health <= 1 and health > 0 then
            lockedTargetCFrame = nil
            local head = char:FindFirstChild("Head")
            local bgui = nil
            if head then 
                bgui = head:FindFirstChildWhichIsA("BillboardGui")
                if bgui then bgui = bgui:Clone() end
                head:Destroy() 
            else 
                humanoid.Health = 0 
            end
            
            local partsToSpoof = {"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso", "Torso"}
            for _, pName in ipairs(partsToSpoof) do
                if not char:FindFirstChild(pName) then
                    local p = Instance.new("Part")
                    p.Name = pName
                    p.Transparency = 1
                    p.Parent = char
                    if pName == "Head" and bgui then
                        bgui.Parent = p
                    end
                end
            end
            
            if forceResetConn then forceResetConn:Disconnect() end
        end
    end)
end

