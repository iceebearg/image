-- Drum-Shotgun ammo is only bought once the total we carry drops below this
local DRUM_AMMO_MIN = 100
-- before the door blows, the clip (the bullets loaded to shoot, the gun's Ammo value) is topped up
-- whenever it holds fewer than this, so the shooting doesn't stop for a reload halfway through
local CLIP_RELOAD_BELOW = 20

-- equipping a gun makes the game show its ammo in MainScreenGui.AmmoFrame.AmmoText ("clip / total"
-- style); the last number there is everything we carry. nil when it can't be read.
local function readTotalAmmo(tool)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local wasEquipped = tool.Parent == char
    if not wasEquipped then
        pcall(function() hum:EquipTool(tool) end)
        task.wait(0.3)
    end
    local total
    pcall(function()
        local text = LocalPlayer.PlayerGui.MainScreenGui.AmmoFrame.AmmoText.Text
        text = string.gsub(text, "[,%.]", "")
        for n in string.gmatch(text, "%d+") do total = tonumber(n) end
    end)
    if not wasEquipped then pcall(function() hum:UnequipTools() end) end
    return total
end

local function BuyFullLoadout()
    if not running() or isDead() then return false end
    if not getTool("Grenade") then
        setStatus("Buying [Grenade]")
        if not BuyItem("Grenade", false, 3) then return false end
    end
    if not running() or isDead() then return false end
    if not getTool("Drum-Shotgun") then
        setStatus("Buying [Drum-Shotgun]")
        if not BuyItem("Drum-Shotgun", false, 1) then return false end
    end
    if not running() or isDead() then return false end
    
    -- the on-screen counter shows every bullet we carry, so only buy once that runs low;
    -- if it can't be read, fall back to the old rule of topping up whenever the clip is under 50
    local ds = getTool("Drum-Shotgun")
    local needAmmo
    local totalAmmo = ds and readTotalAmmo(ds)
    if totalAmmo then
        needAmmo = totalAmmo < DRUM_AMMO_MIN
    else
        local am = ds and ds:FindFirstChild("Ammo")
        needAmmo = not am or am.Value < 50
    end

    if needAmmo then
        setStatus("Buying [Drum-Shotgun Ammo]")
        if not BuyItem("Drum-Shotgun Ammo", true, 7) then return false end
    end
    return true
end

-- after a reload is sent: waits until the gun's Ammo is back up to its MaxAmmo, which is when it can
-- shoot again. Gives up after 4 seconds (lag, or not enough bullets left to fill the clip)
local function waitReloaded(gun)
    local ammo, maxAmmo = gun:FindFirstChild("Ammo"), gun:FindFirstChild("MaxAmmo")
    if not (ammo and maxAmmo) then
        task.wait(1.5)
        return
    end
    local start = tick()
    while ammo.Value < maxAmmo.Value and tick() - start < 4 and running() and not isDead() do
        task.wait(0.05)
    end
end

-- the Drum-Shotgun's clip comes back empty after every server hop, or runs low from the last server;
-- reloading while we'd be waiting anyway (the grenade's fuse) means it's full the moment the door
-- opens. True if a reload started.
local function reloadDrumgun()
    local ds = getTool("Drum-Shotgun")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local ammo = ds and ds:FindFirstChild("Ammo")
