local function create(className, parent, props)
    local inst = Instance.new(className)
    for k, v in pairs(props) do inst[k] = v end
    inst.Parent = parent
    return inst
end

local function corner(parent, radius)
    return create("UICorner", parent, {CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius)})
end

local function label(parent, props)
    props.BackgroundTransparency = 1
    props.AutoLocalize = false
    props.FontFace = props.FontFace or font()
    props.TextColor3 = props.TextColor3 or Theme.Text
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return create("TextLabel", parent, props)
end

-- glass edge: light catches the top rim, fades through the middle and comes back faintly at the bottom
local function specular(parent, topTransparency)
    local stroke = create("UIStroke", parent, {
        Color = Theme.White,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    create("UIGradient", stroke, {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, topTransparency or 0.7),
            NumberSequenceKeypoint.new(0.5, 0.93),
            NumberSequenceKeypoint.new(1, 0.85),
        }),
    })
    return stroke
end

local function glass(parent, props, className, radius)
    props.BackgroundColor3 = props.BackgroundColor3 or Theme.White
    props.BackgroundTransparency = props.BackgroundTransparency or 0.955
    props.BorderSizePixel = 0
    if className == "TextButton" then
        props.AutoButtonColor = false
        props.AutoLocalize = false
        props.Text = props.Text or ""
    end
    local f = create(className or "Frame", parent, props)
    corner(f, radius or 14)
    -- a gradient would also fade the button's own text, so only plain surfaces get the top-lit fill
    if f.ClassName ~= "TextButton" or f.Text == "" then
        create("UIGradient", f, {Rotation = 90, Transparency = NumberSequence.new(0, 0.6)})
    end
    return f, specular(f, 0.72)
end

local sprites = {}

local localAssets = {}
local getLocalAsset = getcustomasset or getsynasset

-- downloads a hosted PNG once into the executor's workspace folder; later runs read it from disk
local function downloadIcon(url)
    local name = string.match(url, "([^/?#]+)[^/]*$")
    if not name or not writefile then return nil end
    local path = "VaultFarm/icons/" .. name
    local exists = false
    pcall(function() exists = isfile(path) end)
    if not exists then
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or type(body) ~= "string" or #body == 0 then return nil end
        pcall(function()
            if makefolder then
                makefolder("VaultFarm")
                makefolder("VaultFarm/icons")
            end
            writefile(path, body)
        end)
    end
    return path
end

local function assetUrl(id)
    if not id or id == "" then return nil end
    if tonumber(id) then return "rbxassetid://" .. id end
    if string.find(id, "^https?://") then
        if localAssets[id] == nil then
            local path = downloadIcon(id)
            local ok, url = pcall(function() return getLocalAsset(path) end)
            localAssets[id] = (path and ok and url) or false
        end
        return localAssets[id] or nil
    end
    -- "file:VaultFarm/money.png" loads a PNG from the executor's workspace folder, no upload needed
    local path = string.match(id, "^file:(.+)$")
    if path then
        if localAssets[path] == nil then
            local ok, url = pcall(function() return getLocalAsset(path) end)
            localAssets[path] = ok and url or false
        end
        return localAssets[path] or nil
    end
    return id
end

local function iconImage(name)
    local def = Icons[name]
    return assetUrl(type(def) == "table" and def.id or def)
end

local function setSpriteFrame(img, def, frame)
    local size = def.size or 1024
    local fw, fh = def.cell or size / def.cols, def.cell or size / def.rows
    img.ImageRectSize = Vector2.new(fw, fh)
    img.ImageRectOffset = Vector2.new((frame % def.cols) * fw, math.floor(frame / def.cols) * fh)
end

-- points an ImageLabel at an icon; sprite sheets loop unless autoplay is false
local function applyIcon(img, name, autoplay)
    local def = Icons[name]
    img.Image = iconImage(name) or ""
    if type(def) == "table" and def.cols and def.rows then
        setSpriteFrame(img, def, 0)
        sprites[img] = {def = def, time = 0, frame = 0, playing = autoplay ~= false, loop = autoplay ~= false}
    else
        img.ImageRectSize = Vector2.zero
        img.ImageRectOffset = Vector2.zero
        sprites[img] = nil
    end
end

local function playSprite(img)
    local s = sprites[img]
    if s then s.time, s.frame, s.playing = 0, -1, true end
end

local function icon(parent, name, size, props, autoplay)
    if not iconImage(name) then return nil end
    props = props or {}
    props.BackgroundTransparency = 1
    props.Size = UDim2.fromOffset(size, size)
    props.ImageColor3 = props.ImageColor3 or Theme.Text
    local img = create("ImageLabel", parent, props)
    applyIcon(img, name, autoplay)
    return img
end

local function addPressEffect(button)
    local scale = create("UIScale", button, {})
    local base = button.BackgroundTransparency
    button.MouseEnter:Connect(function() tween(button, 0.2, {BackgroundTransparency = base - 0.03}) end)
    button.MouseLeave:Connect(function()
        tween(button, 0.2, {BackgroundTransparency = base})
        tween(scale, 0.3, {Scale = 1})
    end)
    button.MouseButton1Down:Connect(function() tween(scale, 0.12, {Scale = 0.96}, Enum.EasingStyle.Quad) end)
    button.MouseButton1Up:Connect(function() tween(scale, 0.5, {Scale = 1}, Enum.EasingStyle.Back) end)
end

