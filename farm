local function getTool(exactName)
    if not exactName then return nil end
    local lp = Players.LocalPlayer
    local char = lp and lp.Character
    local bp = lp and lp:FindFirstChild("Backpack")
    local realName = string.lower(string.gsub(string.gsub(exactName, "%[", ""), "%]", ""))
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") and string.find(string.lower(v.Name), realName, 1, true) then return v end
        end
    end
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") and string.find(string.lower(v.Name), realName, 1, true) then return v end
        end
    end
    return nil
end

local shopCache = {}
local shopMissUntil = {}
local function findShopPart(keyword)
    local cached = shopCache[keyword]
    if cached and cached[1].Parent and cached[2].Parent then return cached[1], cached[2], cached[3] end
    -- a miss scans the whole map, so don't retry it every frame
    if shopMissUntil[keyword] and tick() < shopMissUntil[keyword] then return nil, nil, nil end
    local targetSearchName = string.lower(string.gsub(string.gsub(keyword, "%[", ""), "%]", ""))
    local searchFolders = {workspace:FindFirstChild("Ignored"), workspace:FindFirstChild("Shops"), workspace}
    for _, folder in ipairs(searchFolders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                local name = string.lower(obj.Name)
                if not string.find(name, "carpet") and not string.find(name, "dhc") and not string.find(name, "skin") and not string.find(name, "crate") and not string.find(name, "launcher") then
                    if string.find(name, targetSearchName, 1, true) then
                        -- a weapon search must not land on that weapon's ammo stand ("drum-shotgun" vs "drum-shotgun ammo")
                        if not (string.find(name, "ammo", 1, true) and not string.find(targetSearchName, "ammo", 1, true)) then
                            local cd = obj:FindFirstChildWhichIsA("ClickDetector", true)
                            local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                            local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Head", true) or obj:FindFirstChildWhichIsA("BasePart", true)
                            if cd and part then shopCache[keyword] = {part, cd, pp} return part, cd, pp end
                        end
                    end
                end
            end
        end
    end
    shopMissUntil[keyword] = tick() + 2
    return nil, nil, nil
end

local function triggerShopInteraction(shopPart, cd, pp)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if cd then pcall(function() safeFireClick(cd) end) end
    if pp then pcall(function() safeFirePrompt(pp) end) end
    if shopPart then
        pcall(function()
            safeFireTouch(hrp, shopPart, 0)
            task.wait()
            safeFireTouch(hrp, shopPart, 1)
        end)
    end
    task.wait(0.02)
end

