local function BuyItem(itemName, isAmmo, clicks)
    local t_start = tick()
    while running() do
        if getgenv().FarmPaused then t_start = tick(); task.wait(0.1); continue end
        if tick() - t_start > 6 then break end
        
        if isDead() then return false end
        local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        if not isAmmo then
            local t = getTool(itemName)
            if t then break end
        end
        
        local part, cd, pp = findShopPart("[" .. itemName .. "]")
        if part and hrp then
            local targetPos = (part.CFrame * CFrame.new(0, 3, 0)).Position
            securePosition(hrp, targetPos, part.Position)
            for i = 1, (clicks or 1) do
                if getgenv().FarmPaused then break end
                if isDead() then return false end
                triggerShopInteraction(part, cd, pp)
                task.wait(0.2)
            end
            if isAmmo and not getgenv().FarmPaused then break end
        end
        task.wait()
    end
    return true
end

local function BuyFullLoadout()
