-- Low memory mode: strips what only makes the map look nicer (particles, decals and textures, PBR
-- surfaces, post effects, shadows, top graphics quality) and keeps doing it for whatever shows up
-- later (shot effects, debris). Parts, scripts, sounds and anything inside a tool are never touched,
-- so nothing the farm or the game's own scripts rely on goes missing. What's stripped only comes
-- back by rejoining; turning it off just stops stripping new things.
local applyLowMemory
do
    local conn
    local STRIP = {
        ParticleEmitter = true, Trail = true, Beam = true, Smoke = true, Fire = true, Sparkles = true,
        Decal = true, Texture = true, SurfaceAppearance = true,
    }
    local function strip(obj)
        if STRIP[obj.ClassName] then
            if not obj:FindFirstAncestorWhichIsA("Tool") then pcall(function() obj:Destroy() end) end
        elseif obj:IsA("MeshPart") and obj.TextureID ~= "" and not obj:FindFirstAncestorWhichIsA("Tool") then
            pcall(function() obj.TextureID = "" end)
        end
    end
    function applyLowMemory(on)
        if conn then
            conn:Disconnect()
            conn = nil
        end
        pcall(function()
            settings().Rendering.QualityLevel = on and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
        end)
        if not on then return end
        local Lighting = game:GetService("Lighting")
        pcall(function() Lighting.GlobalShadows = false end)
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then pcall(function() effect.Enabled = false end) end
        end
        local myConn
        myConn = workspace.DescendantAdded:Connect(function(obj)
            if getgenv().VaultSessionToken ~= sessionToken then
                myConn:Disconnect()
                return
            end
            strip(obj)
        end)
        conn = myConn
        -- the map is already loaded: go through it in slices so the game doesn't freeze
        task.spawn(function()
            for i, obj in ipairs(workspace:GetDescendants()) do
                if not myConn.Connected then return end
                strip(obj)
                if i % 3000 == 0 then task.wait() end
            end
        end)
    end
end
applyLowMemory(getgenv().LowMemory ~= false)

