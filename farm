local statusColors = {LIVE = Theme.Green, PAUSED = Theme.Gold, HOPPING = Theme.Red}
local lastMode = "LIVE"

local function statusIconFor(text)
    text = string.lower(text)
    if string.find(text, "grenade") or string.find(text, "granade") then return "grenade" end
    if string.find(text, "drum") or string.find(text, "ammo") then return "drumgun" end
    if string.find(text, "breaking vault") then return "vault" end
    if string.find(text, "cash") then return "money" end
    if string.find(text, "mask") then return "mask" end
    if string.find(text, "hop") then return "server" end
    return nil
end

local function setStatus(txt)
    pcall(function()
        if not StatusLabel.Parent then return end
        local mode = getgenv().FarmPaused and "PAUSED" or (getgenv().IsHopping and "HOPPING" or "LIVE")
        local newText = mode == "PAUSED" and "Paused" or tostring(txt)
        if StatusLabel.Text ~= newText then
            local iconName = statusIconFor(newText)
            local hasIcon = iconName ~= nil and iconImage(iconName) ~= nil
            if hasIcon then
                applyIcon(statusIcon, iconName, true)
                statusIcon.Visible = true
                statusIconScale.Scale = 0.5
                tween(statusIconScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
            else
                statusIcon.Visible = false
            end
            local x = hasIcon and 82 or 65
            StatusLabel.Text = newText
            StatusLabel.Position = UDim2.fromOffset(x, 26)
            StatusLabel.TextTransparency = 1
            tween(StatusLabel, 0.35, {Position = UDim2.fromOffset(x, 22), TextTransparency = 0})
        end
        if mode ~= lastMode then
            lastMode = mode
            tween(statusDot, 0.3, {BackgroundColor3 = statusColors[mode]})
        end
    end)
end

