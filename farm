local CAMERA_SPOT = GUN_SPOT + Vector3.new(0, 3, 0)

-- the vault door, or nil while it's blown open. It grows back after a while, and while it stands
-- the vaults take no damage, so every shooting loop keeps checking for it
local function getVaultDoor()
    local map = workspace:FindFirstChild("MAP")
    map = map and map:FindFirstChild("Map")
