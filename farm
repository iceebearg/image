local function tween(obj, duration, props, style, direction, repeatCount, reverses)
    local t = TweenService:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out, repeatCount or 0, reverses or false), props)
