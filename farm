local function blowDoorWithGrenadeTP(char, hrp, door)
    local tool = getTool("Grenade")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (tool and hum and hrp) then return end

    -- thrown from inside the vault, behind the door: the grenade is steered onto the door anyway,
    -- and this way we're already standing by the vaults when it blows
    local vaultCenter = door.Position
    securePosition(hrp, GRENADE_THROW_POS, vaultCenter)

    setStatus("Throwing Grenade")
    hum:EquipTool(tool)
    task.wait(0.3)

    -- only a grenade that appears after our throw is ours; anything already in Ignored is someone else's
    local ignored = workspace:FindFirstChild("Ignored")
    local before = {}
    if ignored then
        for _, obj in ipairs(ignored:GetChildren()) do before[obj] = true end
    end
    pressTool(tool)
    -- pressed a second time if the first didn't throw it, as the throw has always been done
    task.wait(0.5)
    if tool.Parent == char then pressTool(tool) end

    local grenade
    local waitStart = tick()
    while ignored and not grenade and tick() - waitStart < 2 do
        for _, obj in ipairs(ignored:GetChildren()) do
            if not before[obj] and obj:IsA("BasePart") and obj.Name == "Handle" then
                grenade = obj
                break
            end
        end
        if not grenade then RunService.Heartbeat:Wait() end
    end
    if not grenade then
        notify("Grenade", "Nothing showed up in Ignored to guide", Theme.Gold)
        pcall(function() hum:UnequipTools() end)
        return
    end

    -- a thrown grenade no longer needs its tool, so swap to the drum gun and reload during the fuse
    local reloading = reloadDrumgun()
    setStatus("Guiding Grenade onto the door")
    local flyStart = tick()
    while grenade.Parent and tick() - flyStart < 8 do
        local offset = tick() - flyStart < GRENADE_HOVER_SECONDS and GRENADE_HOVER_HEIGHT or 0
        pcall(function() grenade.CFrame = CFrame.new(vaultCenter + Vector3.new(0, offset, 0)) end)
        RunService.Heartbeat:Wait()
    end
    -- the drum gun stays in hand when it's reloading; the shooting comes next anyway
    if not reloading then pcall(function() hum:UnequipTools() end) end

    local doorWait = tick()
    while door.Parent and tick() - doorWait < 2 do task.wait(0.1) end
end

-- Silent aim at the vaults: the game's GunHandler builds every shot from data.AimPosition, so while
-- getgenv().VaultAimPosition is set, our own shots (never anyone else's) go to that point instead.
-- Needs an executor whose require() can load the game's modules, and a GunHandler table it can write
-- to (unfrozen, or setreadonly to unlock it); returns false when that's not the case.
local function hookGunHandler()
    local hooked = false
    pcall(function()
        if type(require) ~= "function" then return end
        local modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules", 10)
        local module = modules and modules:WaitForChild("GunHandler", 10)
        local GunHandler = module and require(module)
        if type(GunHandler) ~= "table" or type(GunHandler.shoot) ~= "function" then return end
        if table.isfrozen and table.isfrozen(GunHandler) then
            if type(setreadonly) ~= "function" then return end
            setreadonly(GunHandler, false)
        end
        -- always wrap the game's own function, so re-running the script doesn't stack wrappers
        local original = getgenv().VaultOriginalShoot or GunHandler.shoot
        getgenv().VaultOriginalShoot = original
        local wrapper
        wrapper = function(data)
            local aim = getgenv().VaultAimPosition
            if aim and type(data) == "table" and data.Shooter == Players.LocalPlayer.Character then
                data.AimPosition = aim
                -- no spread: zero any spread value the shot carries, so every pellet goes at the aim point
                for key, value in pairs(data) do
                    if type(value) == "number" and string.find(string.lower(tostring(key)), "spread", 1, true) then
                        data[key] = 0
                    end
                end
            end
            return original(data)
        end
        GunHandler.shoot = wrapper
        -- some executors fail the write silently, so check it actually took
        hooked = GunHandler.shoot == wrapper
    end)
    return hooked
end

-- what this executor supports, checked once at start. A newer method only runs when everything it
-- relies on is there; otherwise that step uses the older method. Bullet TP and no spread ride on the
-- silent aim hook, so they need it too. The grenade TP only moves a part, which every executor can do.
local support = {silentAim = hookGunHandler()}
support.bulletTP = support.silentAim
do
    local executorName = "This executor"
    pcall(function()
        if identifyexecutor then executorName = tostring((identifyexecutor())) end
    end)
    local missing = {}
    if not support.silentAim then table.insert(missing, "require/module hook (silent aim, bullet TP, no spread: using the normal shooting)") end
    if not firetouchinterest then table.insert(missing, "firetouchinterest (cash pickup)") end
    if not (fireclickdetector or firesignal) then table.insert(missing, "fireclickdetector (shops)") end
    if not (queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)) then table.insert(missing, "queue_on_teleport (farm won't restart after a hop)") end
    if not (request or http_request or (syn and syn.request)) then table.insert(missing, "request (server hop)") end
    if not (writefile and readfile) then table.insert(missing, "writefile/readfile (nothing gets saved)") end
    if #missing == 0 then
        notify("Executor", executorName .. " supports everything", Theme.Green)
    else
        warn("[Vault Farm] " .. executorName .. " is missing: " .. table.concat(missing, "; "))
        notify("Executor", executorName .. " lacks " .. #missing .. " feature(s), details in F9", Theme.Gold)
    end
end

local function aliveVaults()
    local list = {}
    local cashiers = workspace:FindFirstChild("Cashiers")
    if not cashiers then return list end
    for _, v in ipairs(cashiers:GetChildren()) do
        if string.find(string.upper(v.Name), "VAULT") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local head = v:FindFirstChild("Head") or v:FindFirstChild("Part")
            if hum and hum.Health > 0 and head then table.insert(list, {hum = hum, head = head}) end
        end
    end
    return list
end

-- A shooter thread breaks the vaults one after another with silent aim while this thread picks up
-- the cash as it drops. A vault whose health stops going down (shots blocked) is skipped and left
-- for the regular per-vault pass that runs afterwards.
local function shootVaultsWhileCollecting()
    local ds = getTool("Drum-Shotgun")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not (ds and hum) then return end
    local centers = {}
    for _, t in ipairs(aliveVaults()) do table.insert(centers, t.head.Position) end
    if #centers == 0 then return end

    -- Bullet TP: the gun sits in the middle of the vault room and silent aim sends each bullet from
    -- there to the vault being shot. Every frame the hand-to-gun weld (RightGrip) is re-aimed at the
    -- room center, so wherever we move to pick up cash the gun never leaves it, and since the tool is
    -- never re-equipped the held trigger is never dropped. The weld is put back when the phase ends.
    -- Shots fired from more than 15 studs away from us don't count, so when picking up cash takes us
    -- further than that from the room center, the gun slides toward us along the line between the two
    -- and stays at the menu's gun reach; it goes back to the center as soon as we're close again.
    local bulletTP = getgenv().BulletTPVaults ~= false and support.bulletTP
    local roomCenter = GUN_SPOT
    local gripConn
    if bulletTP then
        gripConn = RunService.Heartbeat:Connect(function()
            -- also lets go on its own if the farm stops or errors out mid-phase
            if not running() or not ds.Parent then
                gripConn:Disconnect()
                return
            end
            local char = LocalPlayer.Character
            local hand = char and char:FindFirstChild("RightHand")
            local weld = hand and hand:FindFirstChild("RightGrip")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if weld and root and ds.Parent == char then
                local spot = roomCenter
                local away = roomCenter - root.Position
                local reach = gunReach()
                if away.Magnitude > reach then
                    spot = root.Position + away.Unit * reach
                end
                local target = CFrame.new(spot)
                -- Handle = hand * C0 * C1:Inverse(), solved for the C1 that puts Handle on target
                weld.C1 = target:Inverse() * hand.CFrame * weld.C0
            end
        end)
    end

    -- we're hidden under the floor, so the camera watches the vault room from a fixed invisible part
    -- in its middle instead (it can still be turned and zoomed around it)
    local camPart = Instance.new("Part")
    camPart.Name = "VaultFarmCamera"
    camPart.Size = Vector3.new(1, 1, 1)
    camPart.Transparency = 1
    camPart.Anchored = true
    camPart.CanCollide, camPart.CanQuery, camPart.CanTouch = false, false, false
    camPart.CFrame = CFrame.new(CAMERA_SPOT)
    camPart.Parent = workspace
    pcall(function() workspace.CurrentCamera.CameraSubject = camPart end)

    setStatus("Shooting vaults, picking up cash")
    local phase = {shooting = true, active = true}
    task.spawn(function()
        local skipped = {}
        local current, lastHealth, lastHit
        -- the trigger: the Drum-Shotgun's own script starts firing on Tool.Activated and keeps going, at
        -- its own cooldown, until Tool.Deactivated, the same as holding the mouse down. So ds:Activate()
        -- once is a held trigger and ds:Deactivate() lets go; every shot is the game's own ("Shoot",
        -- GunHandler.shoot per pellet, MainEvent "ShootGun"). No mouse, camera or screen center involved.
        -- It's only let go to reload, re-equip or pause, or to press again if the gun stopped firing.
        local holding = false
        local lastAmmo, lastAmmoChange = nil, tick()
        local function release()
            if holding then
                pcall(function() ds:Deactivate() end)
                holding = false
            end
        end
        while phase.active and running() and not isDead() and not getgenv().IsHopping do
            if getgenv().FarmPaused then
                release()
                lastHit = tick()
                task.wait(0.1)
                continue
            end
            if getVaultDoor() then
                -- the door grew back: shots do nothing until it's blown again
                phase.doorBack = true
                break
            end
            local target
            local alive = aliveVaults()
            for _, t in ipairs(alive) do
                if not skipped[t.hum] then
                    target = t
                    break
                end
            end
            if not target then
                if #alive == 0 then break end
                -- every vault still standing got skipped once (a reload, the gun being re-placed):
                -- give them all another go instead of handing them to the old method
                skipped, current = {}, nil
                task.wait(0.1)
                continue
            end
            if target.hum ~= current then
                current, lastHealth, lastHit = target.hum, target.hum.Health, tick()
            elseif target.hum.Health < lastHealth then
                lastHealth, lastHit = target.hum.Health, tick()
            elseif tick() - lastHit > 4 then
                skipped[target.hum] = true
                continue
            end
            if ds.Parent ~= LocalPlayer.Character then
                release()
                pcall(function() hum:EquipTool(ds) end)
                task.wait(0.2)
            end
            -- silent aim switches targets on its own, so the trigger doesn't need letting go for that
            getgenv().VaultAimPosition = target.head.Position
            local ammo = ds:FindFirstChild("Ammo")
            if ammo and ammo.Value <= 0 then
                release()
                local mainEvent = game:GetService("ReplicatedStorage"):FindFirstChild("MainEvent")
                if mainEvent then mainEvent:FireServer("Reload", ds) end
                waitReloaded(ds)
                lastHit = tick()
            else
                -- the gun's loop ends by itself when it can't shoot for a moment (getCanShoot); if the clip
                -- hasn't moved in a while, let go and press again, like a player re-clicking
                if ammo and ammo.Value ~= lastAmmo then
                    lastAmmo, lastAmmoChange = ammo.Value, tick()
                elseif holding and tick() - lastAmmoChange > 0.75 then
                    release()
                end
                if not holding then
                    pcall(function() ds:Activate() end)
                    holding = true
                    lastAmmoChange = tick()
                end
                task.wait(0.05)
            end
        end
        release()
        getgenv().VaultAimPosition = nil
        phase.shooting = false
    end)

    -- cash keeps dropping while vaults break, so collect until the shooting is over and nothing is left
    -- run protected: if anything in here errors, the shooter thread, the grip and the camera part still
    -- get cleaned up below, instead of a held trigger and a stray thread carrying on into the next round
    local ok, err = pcall(function()
        local started, lastCash = tick(), tick()
        while running() and not isDead() and not getgenv().IsHopping and tick() - started < 60 do
            if getgenv().FarmPaused then
                lastCash = tick()
                task.wait(0.1)
                continue
            end
            if pickUpCash(centers) then
                lastCash = tick()
            elseif not phase.shooting and tick() - lastCash > 1.5 then
                break
            else
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                securePosition(hrp, GRENADE_THROW_POS - Vector3.new(0, cashDepth(), 0), centers[1])
                task.wait(0.1)
            end
            task.wait()
        end
    end)
    phase.active = false
    getgenv().VaultAimPosition = nil
    if gripConn then gripConn:Disconnect() end
    -- unequipping drops the weld, so the next equip starts from the tool's normal grip
    pcall(function() hum:UnequipTools() end)
    pcall(function() workspace.CurrentCamera.CameraSubject = hum end)
    camPart:Destroy()
    if not ok then error(err, 0) end
    return phase.doorBack == true
end

local function farmStep()
    task.wait()
    
    if getgenv().IsHopping then
        if not running() then return "stop" end
        task.wait(1)
        return
    end
    
    while getgenv().FarmPaused and running() do
        setStatus("PAUSED")
        task.wait(0.1)
    end
    if not running() then return "stop" end
    
    if isDead() then
        setStatus("Respawning")
        lockedTargetCFrame = nil
        task.wait(0.5)
        return
    end
    
    if not CheckVaultsExist() then
        setStatus("Serverhopping: No vaults on join.")
        ServerHopLogic("No active vaults found.")
        task.wait(9e9)
        return
    end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("ForceField") then
        setStatus("Waiting for respawnshield to be off")
        task.wait(0.25)
        return
    end
    
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Position.Y < 8 then
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    if not currentSpawnSetup and hrp and getgenv().UseMask == false then
        currentSpawnSetup = true
    end

    if not currentSpawnSetup and hrp then
        local rawMaskName = getgenv().mask
        if type(rawMaskName) ~= "string" or rawMaskName == "" or not string.match(rawMaskName, "%S") then
            local masks = {"Paintball Mask", "Ninja Mask", "Pumpkin Mask", "Skull Mask", "Hockey Mask", "Surgeon Mask"}
            rawMaskName = masks[math.random(1, #masks)]
            getgenv().mask = rawMaskName
        end
        
        local shopMaskName = "[" .. rawMaskName .. "]"
        setStatus("Buying " .. rawMaskName)
        local maskTool = getTool("Mask") or getTool(rawMaskName)
        local maskStart = tick()
        while running() and not maskTool do
            if getgenv().FarmPaused then maskStart = tick(); task.wait(0.1); continue end
            if tick() - maskStart > 6 then break end
            
            local part, cd, pp = findShopPart(shopMaskName)
            if part then
                local randOffset = Vector3.new((math.random() - 0.5) * 5, 3, (math.random() - 0.5) * 5)
                securePosition(hrp, part.Position + randOffset, part.Position)
                triggerShopInteraction(part, cd, pp)
            end
            task.wait(0.1)
            maskTool = getTool("Mask") or getTool(rawMaskName)
        end
        
        maskTool = getTool("Mask") or getTool(rawMaskName)
        if maskTool then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and maskTool.Parent ~= char then
                hum:EquipTool(maskTool)
                task.wait(0.05)
            end
            if maskTool.Parent == char then
                pressTool(maskTool)
                task.wait(0.05)
                if hum then pcall(function() hum:UnequipTools() end) end
                task.wait(0.05)
            end
        end
        currentSpawnSetup = true
        return
    end
    
    if not CheckVaultsExist() then
        setStatus("Serverhopping: All active vaults are empty.")
        ServerHopLogic("All active vaults are empty.")
        task.wait(9e9)
        return
    end
    
    if not BuyFullLoadout() then return end
    
    local v96 = getVaultDoor()
    
    if v96 and v96.Parent and getgenv().DoorMethod ~= "grenade" then
        if not getTool("Grenade") then
            setStatus("Failsafe: Re-buying [Grenade]")
            BuyItem("Grenade", false, 3)
        end
        blowDoorWithGrenadeTP(char, hrp, v96)
    elseif v96 and v96.Parent then
        local nade = getTool("Grenade")
        if not nade then
            setStatus("Failsafe: Re-buying [Grenade]")
            BuyItem("Grenade", false, 3)
            task.wait(0.5)
            nade = getTool("Grenade")
        end

        if nade then
            setStatus("Throwing Granade")
            
            local vaultCenter = v96.Position
            local throwPos = Vector3.new(-618.6, -31.2, -285.4)
            local dirToVault = Vector3.new(vaultCenter.X - throwPos.X, 0, vaultCenter.Z - throwPos.Z)
            if dirToVault.Magnitude < 0.1 then
                dirToVault = Vector3.new(0, 0, -1)
            else
                dirToVault = dirToVault.Unit
            end
            
            local safeBackPos = throwPos - (dirToVault * 22) + Vector3.new(0, 3, 0)
            
            securePosition(hrp, throwPos, throwPos - Vector3.new(0, 10, 0))
            task.wait(0.2)
            
            if isDead() then return end
            
            local cam = workspace.CurrentCamera
            if cam then cam.CameraType = Enum.CameraType.Scriptable end
            
            local Head = char and char:FindFirstChild("Head")
            if Head and cam then 
                cam.CFrame = CFrame.new(Head.Position + Vector3.new(0, 1.5, 0), Head.Position - Vector3.new(0, 10, 0))
            end
            
            if cam then
                local camCenter = cam.ViewportSize / 2
                lockConn = RunService.RenderStepped:Connect(function()
                    if running() and not isDead() and not getgenv().IsHopping then
                        pcall(function()
                            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                            if mousemoverel then mousemoverel(0,0) end 
                            if mousemoveabs then mousemoveabs(camCenter.X, camCenter.Y) end
                            VIM:SendMouseMoveEvent(camCenter.X, camCenter.Y, game)
                        end)
                    end
                end)
            end
            
            local hum = char and char:FindFirstChild("Humanoid")
            if hum then hum:EquipTool(nade) end
            task.wait(0.3)
            
            if not isDead() then
                pressTool(nade)
                task.wait(0.5)
                if nade and char == nade.Parent then pressTool(nade) end
            end
            
            task.wait(0.5)
            securePosition(hrp, safeBackPos, vaultCenter)
            reloadDrumgun()

            task.wait(4.0)
            
            if lockConn then lockConn:Disconnect() end
            pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
            if cam then cam.CameraType = Enum.CameraType.Custom end
            if cam and hum then cam.CameraSubject = hum end
            if hum then hum:UnequipTools() end
        end
    end
    
    if isDead() then return end
    while getgenv().FarmPaused and running() do task.wait(0.1) end
    if not running() then return "stop" end

    -- with silent aim available the old per-vault pass never runs; any vault left standing just gets
    -- another silent-aim round
    local usedSilentAim = getgenv().SilentAimVaults ~= false and support.silentAim
    if usedSilentAim then
        for _ = 1, 3 do
            if #aliveVaults() == 0 then break end
            -- door up again (it grew back, or the grenade didn't take it): the next pass blows it
            if getVaultDoor() then return end
            local doorBack = shootVaultsWhileCollecting()
            if isDead() then return end
            if not running() then return "stop" end
            if doorBack then return end
        end
    end

    -- regular pass (only without silent aim): walks up to each vault and shoots it with the camera
    local Cashiers = not usedSilentAim and workspace:FindFirstChild("Cashiers")
    if Cashiers then
        local brokenVaults = {}
        for _, v in ipairs(Cashiers:GetChildren()) do
            if isDead() or not running() or getgenv().IsHopping or getVaultDoor() then break end
            if not string.find(string.upper(v.Name), "VAULT") then continue end
            local Humanoid2 = v:FindFirstChildOfClass("Humanoid")
            local Head = v:FindFirstChild("Head") or v:FindFirstChild("Part")
            if not (Humanoid2 and Humanoid2.Health > 0 and Head) then continue end
            local ds = getTool("Drum-Shotgun")
            if not ds then break end
            
            setStatus("Breaking Vaults")
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then hum:EquipTool(ds) end
            task.wait(0.2)
            if isDead() then break end
            
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            local sideLook = Head.CFrame.RightVector * (math.random() > 0.5 and 5 or -5)
            local breakPos = Head.CFrame * CFrame.new(0, 0, 3.5).Position

            -- trigger held (the gun fires on its own until Deactivate), let go only to reload
            pcall(function() ds:Activate() end)
            while Humanoid2 and Humanoid2.Health > 0 and v.Parent and running() and not isDead() and not getgenv().IsHopping and not getgenv().FarmPaused and not getVaultDoor() do
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                securePosition(hrp, breakPos + sideLook, Head.Position)
                
                local cam = workspace.CurrentCamera
                if cam then
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, Head.Position)
                end
                
                local Ammo = ds:FindFirstChild("Ammo")
                if Ammo and Ammo.Value <= 0 then
                    pcall(function() ds:Deactivate() end)
                    local MainEvent = game:GetService("ReplicatedStorage"):FindFirstChild("MainEvent")
                    if MainEvent then MainEvent:FireServer("Reload", ds) end
                    waitReloaded(ds)
                    if isDead() then break end
                    securePosition(hrp, breakPos + sideLook, Head.Position)
                    pcall(function() ds:Activate() end)
                end

                task.wait(0.05)
            end
            pcall(function() ds:Deactivate() end)

            if isDead() then break end
            table.insert(brokenVaults, Head.Position)
        end
        
        local finalHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if finalHum then finalHum:UnequipTools() end
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        task.wait(0.1)
        
        for _, pos in ipairs(brokenVaults) do
            if isDead() or not running() or getgenv().IsHopping then break end
            if not CollectVaultCash(pos) then break end
        end
    end
    
    if isDead() then return end
    
    if not CheckVaultsExist() then
        setStatus("Serverhopping: All vaults cleared successfully.")
        ServerHopLogic("All vaults cleared successfully.")
        task.wait(1)
    end
end

-- every pass of the farm runs protected: an unexpected error is reported, the camera and mouse
-- are handed back, and the farm carries on instead of silently dying
local consecutiveErrors = 0
while running() do
    local ok, result = pcall(farmStep)
    if ok then
        consecutiveErrors = 0
        if result == "stop" then break end
    else
        consecutiveErrors = consecutiveErrors + 1
        warn("[Vault Farm] " .. tostring(result))
        getgenv().VaultAimPosition = nil
        pcall(function() getTool("Drum-Shotgun"):Deactivate() end)
        if lockConn then pcall(function() lockConn:Disconnect() end) end
        lockedTargetCFrame = nil
        pcall(function()
            if gui.Parent then gui.Enabled = true end
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            local cam = workspace.CurrentCamera
            cam.CameraType = Enum.CameraType.Custom
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
            local camPart = workspace:FindFirstChild("VaultFarmCamera")
            if camPart then camPart:Destroy() end
        end)
        if consecutiveErrors == 1 or consecutiveErrors % 5 == 0 then
            notify("Recovered from an error", (string.gsub(tostring(result), "^.-:%d+: ", "")), Theme.Gold)
        end
        if consecutiveErrors >= 10 then
            -- something in this server keeps breaking the farm; a fresh server usually fixes it
            consecutiveErrors = 0
            ServerHopLogic("Too many errors, switching server")
        end
        task.wait(math.min(consecutiveErrors, 5))
    end
end
