        BorderSizePixel = 0,
    })
    corner(track, UDim.new(1, 0))
    local knob = create("Frame", track, {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.fromOffset(22, 22),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
    })
    corner(knob, UDim.new(1, 0))
    create("UIStroke", knob, {Color = Theme.Black, Transparency = 0.85, Thickness = 1})

    local state = initial
    local function render(animate)
        tween(track, animate and 0.25 or 0, {BackgroundColor3 = state and Theme.Green or Theme.Track}, Enum.EasingStyle.Quad)
        tween(knob, animate and 0.45 or 0, {
            AnchorPoint = state and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
            Position = state and UDim2.new(1, -2, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
            Size = UDim2.fromOffset(22, 22),
        }, Enum.EasingStyle.Back)
    end
    render(false)

    -- the knob stretches while pressed, like iOS
    hit.MouseButton1Down:Connect(function() tween(knob, 0.15, {Size = UDim2.fromOffset(27, 22)}, Enum.EasingStyle.Quad) end)
    hit.MouseEnter:Connect(function() tween(row, 0.2, {BackgroundTransparency = 0.935}) end)
    hit.MouseLeave:Connect(function()
        tween(row, 0.2, {BackgroundTransparency = 0.955})
        tween(knob, 0.2, {Size = UDim2.fromOffset(22, 22)})
    end)
    hit.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        onChange(state)
        saveConfig()
        notify(title, state and "On" or "Off", state and Theme.Green or Theme.Muted)
    end)
end

