-- per-server history, kept in a file so it survives server hops and game restarts
local HISTORY_FILE = "VaultFarm_History.json"
local BAR_COUNT = 24
local history = {}
pcall(function()
    local data = HttpService:JSONDecode(readfile(HISTORY_FILE))
    if type(data) == "table" then history = data end
end)
for _, e in ipairs(history) do
    e.earned = tonumber(e.earned) or 0
    e.seconds = tonumber(e.seconds) or 0
end
local currentEntry = history[#history]
if not currentEntry or currentEntry.id ~= game.JobId then
    currentEntry = {id = game.JobId, earned = 0, seconds = 0, t = os.time()}
    table.insert(history, currentEntry)
    while #history > BAR_COUNT do table.remove(history, 1) end
end
serverValue.Text = "$" .. formatShort(currentEntry.earned)

local function saveHistory()
    if not writefile then return end
    pcall(function() writefile(HISTORY_FILE, HttpService:JSONEncode(history)) end)
end

local function historyRate()
    local earned, seconds = 0, 0
    for _, e in ipairs(history) do
        earned = earned + e.earned
        seconds = seconds + e.seconds
    end
    if seconds < 60 then return nil end
    return earned / (seconds / 3600)
end

local function formatDuration(seconds)
    seconds = math.floor(seconds)
    if seconds >= 3600 then return string.format("%dh %dm", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60)) end
    if seconds >= 60 then return string.format("%dm %ds", math.floor(seconds / 60), seconds % 60) end
    return seconds .. "s"
end

local function entryAt(i)
    return history[#history - BAR_COUNT + i]
end

