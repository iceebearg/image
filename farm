    end
    if not running() or isDead() then return false end
    if not getTool("Drum-Shotgun") then
        setStatus("Buying [Drum-Shotgun]")
        if not BuyItem("Drum-Shotgun", false, 1) then return false end
    end
    if not running() or isDead() then return false end
    
    local ds = getTool("Drum-Shotgun")
    local currentAmmo = 0
