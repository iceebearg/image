local function CheckVaultsExist()
    local cashiers = workspace:WaitForChild("Cashiers", 10)
    if not cashiers then return false end 
    local count = 0
    for _, child in ipairs(cashiers:GetChildren()) do
        if string.find(string.upper(child.Name), "VAULT") then
            local hum = child:FindFirstChild("Humanoid")
            local head = child:FindFirstChild("Head") or child:FindFirstChild("Part")
            if hum and hum.Health > 0 and head then count = count + 1 end
