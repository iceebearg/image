-- anti-AFK without input: the 20-minute idle kick comes from a listener on LocalPlayer.Idled, and the farm's
-- teleports don't count as input, so those listeners are switched off while the farm runs (re-checked every
-- 30 s in case one gets connected later) and switched back on when it stops
task.spawn(function()
    local getconns = getconnections or get_signal_cons
    if not getconns then return end
    local function setIdleListeners(on)
        pcall(function()
            for _, conn in ipairs(getconns(LocalPlayer.Idled)) do
                pcall(function()
                    if on then conn:Enable()
                    elseif conn.Disable then conn:Disable()
                    else conn:Disconnect() end
                end)
            end
        end)
    end
    while getgenv().VaultSessionToken == sessionToken and (shared.VaultFarm or getgenv().IsHopping) do
        setIdleListeners(false)
        task.wait(30)
    end
    setIdleListeners(true)
end)

