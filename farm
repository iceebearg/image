-- how far below the floor we stand while picking up cash and while waiting for more to drop (menu setting)
local function cashDepth()
    return math.clamp(tonumber(getgenv().CashDepth) or 6, 1, 15)
end

-- the vault (its center point) whose cash is being picked up. We stay on it until all of its cash is
-- gone and only then move to the next vault: jumping back and forth between vaults while they break
-- is slower, and some pickups don't register when we keep teleporting away
local cashFocus

-- picks up one cash drop lying within 15 studs of one of the given points (vault centers): the one
-- nearest to us around the vault we're already on, or around the next vault once that one is empty.
-- Returns false when there's nothing to pick up
local function pickUpCash(centers)
    local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local dropFolder = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Drop")
    if not (hrp and dropFolder) then return false end

    -- every drop belongs to the vault it lies closest to
    local byCenter = {}
    for _, drop in ipairs(dropFolder:GetChildren()) do
        if drop.Name == "MoneyDrop" or string.find(string.lower(drop.Name), "money") or string.find(string.lower(drop.Name), "cash") then
            local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local best, bestDist = nil, 15
                for i, center in ipairs(centers) do
                    local dist = (part.Position - center).Magnitude
                    if dist <= bestDist then best, bestDist = i, dist end
                end
                if best then
                    byCenter[best] = byCenter[best] or {}
                    table.insert(byCenter[best], {drop, part})
                end
            end
        end
    end

    -- stay on the current vault while it still has cash; otherwise switch to the vault whose cash is nearest
    local group
    for i, center in ipairs(centers) do
        if center == cashFocus then group = byCenter[i] end
    end
    if not group then
        cashFocus = nil
        local nearest = 9e9
        for i, list in pairs(byCenter) do
            for _, item in ipairs(list) do
                local dist = (item[2].Position - hrp.Position).Magnitude
                if dist < nearest then nearest, cashFocus, group = dist, centers[i], list end
            end
        end
    end
    if not group then return false end

    local foundCash, cashPart
    local closestDist = 9e9
    for _, item in ipairs(group) do
        local dist = (item[2].Position - hrp.Position).Magnitude
        if dist < closestDist then closestDist, foundCash, cashPart = dist, item[1], item[2] end
    end

    -- stand under the floor right below the cash: still close enough to pick it up, but out of sight
    lastVaultCashOffset = Vector3.new(0, -cashDepth(), 0)
    securePosition(hrp, cashPart.Position + lastVaultCashOffset, cashPart.Position)

    local cd = foundCash:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then pcall(function() safeFireClick(cd) end) end
    pcall(function() safeFireTouch(hrp, cashPart, 0) end)
    task.wait(0.01)
    pcall(function() safeFireTouch(hrp, cashPart, 1) end)
    task.wait(0.05)
    return true
end

local function CollectVaultCash(baseTargetPos)
    setStatus("Picking up cash")
    local collectStartTime = tick()
    while running() do
        if getgenv().FarmPaused then collectStartTime = tick(); task.wait(0.1); continue end
        if (tick() - collectStartTime) > 15 then break end
        if isDead() then return false end
        if not pickUpCash({baseTargetPos}) and (tick() - collectStartTime) > 1.5 then break end
        task.wait()
    end
    return true
end

