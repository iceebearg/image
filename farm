local lockedTargetCFrame = nil

local function securePosition(hrp, targetPos, lookData)
    if getgenv().FarmPaused then return end
    if hrp and targetPos then
        safePlatform.CFrame = CFrame.new(targetPos.X, targetPos.Y - 3.5, targetPos.Z)
        local myPos = Vector3.new(targetPos.X, targetPos.Y - 0.5, targetPos.Z)
        if typeof(lookData) == "Vector3" then
            if (lookData - myPos).Magnitude > 0.01 then
                local lookDir = (lookData - myPos).Unit
                if math.abs(lookDir.Y) > 0.99 then
                    lockedTargetCFrame = CFrame.new(myPos) * CFrame.Angles(math.rad(-90 * math.sign(lookDir.Y)), 0, 0)
                else
                    lockedTargetCFrame = CFrame.lookAt(myPos, lookData)
                end
            else
                lockedTargetCFrame = CFrame.new(myPos) * hrp.CFrame.Rotation
            end
        elseif typeof(lookData) == "CFrame" then
            lockedTargetCFrame = CFrame.new(myPos) * lookData.Rotation
        else
            lockedTargetCFrame = CFrame.new(myPos) * hrp.CFrame.Rotation
        end
        hrp.CFrame = lockedTargetCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function FormatMoney(amount)
    local formatted = tostring(amount)
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
        if k == 0 then break end
    end
    return formatted
end

local function FormatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

