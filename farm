-- every farm click goes through here: if the menu was dragged over the click point,
-- hide it for that instant so the click reaches the game instead of a menu button
local function overlapsMenu(x, y)
    if not gui.Parent or not gui.Enabled or not holder.Visible then return false end
    local pos, size = main.AbsolutePosition, main.AbsoluteSize
    return x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y
end

local function clickCenter(holdTime)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local center = cam.ViewportSize / 2
    local hide = overlapsMenu(center.X, center.Y)
    if hide then gui.Enabled = false end
    pcall(function() VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0) end)
    task.wait(holdTime or 0.05)
    pcall(function() VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0) end)
    if hide and gui.Parent then gui.Enabled = true end
end

