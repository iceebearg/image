-- queues the farm to start again by itself after the next teleport, carrying the session over
local resumeQueued = false
local function queueResume()
    if resumeQueued then return end
    local qot = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if qot then
        resumeQueued = true
        local currentMask = getgenv().mask or ""
        local skName = getgenv().StopKeybindName or ""
        local fpState = tostring(getgenv().FarmPaused or false)
        local webhookUrl = tostring(getgenv().Webhook or "")
        local staffState = tostring(getgenv().StaffDetector ~= false)
        local maskState = tostring(getgenv().UseMask ~= false)
        local render3DState = tostring(getgenv().Disable3DRender == true)
        local blackState = tostring(getgenv().BlackScreen == true)
        local fpsCap = math.floor(tonumber(getgenv().FPSCap) or 0)
        local totalTime = math.floor(getgenv().SavedSessionTime)
        local hopTime = os.time()
        
        local qot_script = string.format([[
        task.spawn(function()
            if os.time() - %d > 600 then return end
            repeat task.wait() until game:IsLoaded()
            task.wait(2)
            getgenv().VaultWebhookSent = true
            getgenv().SavedSessionMoney = %d
            getgenv().SavedSessionTime = %d
            getgenv().mask = "%s"
            getgenv().StopKeybindName = "%s"
            getgenv().FarmPaused = %s
            getgenv().Webhook = %q
            getgenv().StaffDetector = %s
            getgenv().UseMask = %s
            getgenv().Disable3DRender = %s
            getgenv().BlackScreen = %s
            getgenv().FPSCap = %d
            pcall(function()
                if readfile and loadstring then
                    local cached = readfile("Vault_Cache.lua")
                    if cached and #cached > 10 then
                        local func = loadstring(cached)
                        if func then task.spawn(func) end
                    end
                end
            end)
        end)
        ]], hopTime, sessionMoney or 0, totalTime, currentMask, skName, fpState, webhookUrl, staffState, maskState, render3DState, blackState, fpsCap)
        pcall(function() qot(qot_script) end)
    end
end

local function ServerHopLogic(reason)
    if getgenv().IsHopping then return end
    getgenv().IsHopping = true
    setStatus(reason or "Server Hopping (Proxied)...")
    task.spawn(SendWebhook, "Server hop: " .. tostring(reason or "Server Hopping"))
    notify("Server hop", tostring(reason or "Finding a new server"), Theme.Red)
    saveHistory()
    -- stamped on the way out, since the vaults start refilling from the moment we emptied them
    markVisited(tostring(game.JobId))
    shared.VaultFarm = false
    queueResume()

    task.spawn(function()
        local cursor = ""
        while getgenv().IsHopping and task.wait(1) do
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            
            local req = (request or http_request or (syn and syn.request))
            local decoded = nil
            
            if req then
                local s, res = pcall(function() return req({Url = url, Method = "GET"}) end)
                if not s or not res or not res.Body then
                    local proxiedUrl = string.gsub(url, "games%.roblox%.com", "games.roproxy.com")
                    s, res = pcall(function() return req({Url = proxiedUrl, Method = "GET"}) end)
                end
                if s and res and res.Body then pcall(function() decoded = HttpService:JSONDecode(res.Body) end) end
            end
            
            if decoded and decoded.data then
                local servers = {}
                for _, v in ipairs(decoded.data) do
                    if type(v) == "table" and v.playing and v.playing >= 1 and v.playing <= 15 then
                        local id = tostring(v.id)
                        if id ~= tostring(game.JobId) and not recentlyVisited(id) then
                            table.insert(servers, id)
                        end
                    end
                end
                
                if #servers > 0 then
                    local targetServer = servers[math.random(1, #servers)]
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
                    end)
                    task.wait(10)
                elseif decoded.nextPageCursor then
                    cursor = decoded.nextPageCursor
                else
                    -- every listed server was emptied in the last 16 minutes; give them time to refill
                    cursor = ""
                    setStatus("All servers recently farmed, waiting")
                    task.wait(15)
                end
            end
        end
    end)
end

