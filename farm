-- the throw. It hovers above the door first (it needs a moment before moving it sticks), then sits
-- on the door until its fuse goes off.
local GRENADE_HOVER_HEIGHT, GRENADE_HOVER_SECONDS = 5, 1.25
local GRENADE_THROW_POS = Vector3.new(-659, -31, -289)
-- where the bullet TP parks the gun: the middle of the vault room, with a clear shot at all four safes
local GUN_SPOT = Vector3.new(-659, -31, -286)
