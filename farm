local function ServerHopLogic(reason)
    if getgenv().IsHopping then return end
    getgenv().IsHopping = true
    setStatus(reason or "Server Hopping (Proxied)...")
    task.spawn(SendWebhook, "Server hop: " .. tostring(reason or "Server Hopping"))
    notify("Server hop", tostring(reason or "Finding a new server"), Theme.Red)
    saveHistory()
    -- stamped on the way out, since the vaults start refilling from the moment we emptied them
    markVisited(tostring(game.JobId))
    shared.VaultFarm = false
    queueResume()

    task.spawn(function()
        local req = request or http_request or (syn and syn.request)
        -- one page of the server list is fetched and then worked through, so a failed teleport moves on to
        -- the next server instead of asking Roblox for the list again: asking too often gets it rate-limited
        -- (429), and retrying every second kept it that way
        local candidates, cursor, failures = {}, "", 0
        local teleportFailed = false
        local failConn = TeleportService.TeleportInitFailed:Connect(function(player)
            if player == LocalPlayer then teleportFailed = true end
        end)
        local function waitTeleport()
            local start = tick()
            while getgenv().IsHopping and not teleportFailed and tick() - start < 12 do task.wait(0.25) end
        end
        -- the list from roblox.com, or from the proxy when roblox.com fails or rate-limits; nil if both do
        local function fetchPage()
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            for _, u in ipairs({url, (string.gsub(url, "games%.roblox%.com", "games.roproxy.com"))}) do
                local s, res = pcall(function() return req({Url = u, Method = "GET"}) end)
                local decoded
                if s and res and res.Body then pcall(function() decoded = HttpService:JSONDecode(res.Body) end) end
                if type(decoded) == "table" and type(decoded.data) == "table" then return decoded end
            end
        end

        while getgenv().IsHopping do
            if #candidates == 0 then
                local decoded = req and fetchPage()
                if not decoded then
                    failures = failures + 1
                    if not req or failures >= 3 then
                        -- no list to pick from: a plain rejoin still lands on a random server; if it has no
                        -- vaults the farm just hops again from there
                        failures = 0
                        setStatus("Server list unavailable, rejoining a random server")
                        teleportFailed = false
                        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                        waitTeleport()
                    else
                        local delay = 4 * failures
                        setStatus("Server list rate-limited, retrying in " .. delay .. "s")
                        task.wait(delay)
                    end
                    continue
                end
                failures = 0
                for _, v in ipairs(decoded.data) do
                    if type(v) == "table" and v.playing and v.playing >= 1 and v.playing <= 15 then
                        local id = tostring(v.id)
                        if id ~= tostring(game.JobId) and not recentlyVisited(id) then
                            table.insert(candidates, math.random(1, #candidates + 1), id)
                        end
                    end
                end
                cursor = decoded.nextPageCursor or ""
                if #candidates == 0 then
                    if cursor == "" then
                        -- every listed server was emptied in the last 16 minutes; give them time to refill
                        setStatus("All servers recently farmed, waiting")
                        task.wait(15)
                    else
                        task.wait(1)
                    end
                    continue
                end
            end
            setStatus("Joining a new server (" .. #candidates .. " left)")
            local targetServer = table.remove(candidates)
            teleportFailed = false
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
            end)
            -- a failed teleport (server filled up, shut down) moves on to the next one right away
            waitTeleport()
        end
        failConn:Disconnect()
    end)
end

-- when Roblox shows a disconnect or kick prompt mid-farm, rejoin the game; the queued script
-- picks the farm back up on the other side
do
    local GuiService = game:GetService("GuiService")
    local reconnecting = false
    local errorPromptConn
    errorPromptConn = GuiService.ErrorMessageChanged:Connect(function(message)
        if getgenv().VaultSessionToken ~= sessionToken then
            errorPromptConn:Disconnect()
            return
        end
        if reconnecting or not message or message == "" then return end
        if not (shared.VaultFarm or getgenv().IsHopping) then return end
        reconnecting = true
        saveHistory()
        markVisited(tostring(game.JobId))
        queueResume()
        task.spawn(function()
            while true do
                pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                task.wait(8)
            end
        end)
    end)
    -- re-running the script starts a new run; let go of this one's listener right away, otherwise it
    -- would keep this whole old run alive in memory until some error message happened to show up
    task.spawn(function()
        while getgenv().VaultSessionToken == sessionToken do task.wait(5) end
        errorPromptConn:Disconnect()
    end)

    -- staff: anyone ranked above Member in Da Hood Entertainment, or in Da Hood Stars / Da Hood Verified
    local STAFF_GROUP = 4698921
    local FLAGGED_GROUPS = {8068202, 10604500}
    local function isStaff(player)
        local ok, role = pcall(function() return player:GetRoleInGroup(STAFF_GROUP) end)
        if ok and role ~= "Guest" and role ~= "Member" then return true end
        for _, id in ipairs(FLAGGED_GROUPS) do
            local okIn, inGroup = pcall(function() return player:IsInGroup(id) end)
            if okIn and inGroup then return true end
        end
        return false
    end

    -- group lookups are web calls, so each player is checked once (on join, or at start for those
    -- already here) and the answer kept until they leave
    local staffHere = {}
    local function checkPlayer(player)
        if player == LocalPlayer then return end
        if isStaff(player) and player.Parent then staffHere[player] = true end
    end
    for _, p in ipairs(Players:GetPlayers()) do task.spawn(checkPlayer, p) end
    local addedConn = Players.PlayerAdded:Connect(function(p) task.spawn(checkPlayer, p) end)
    local removingConn = Players.PlayerRemoving:Connect(function(p) staffHere[p] = nil end)

    task.spawn(function()
        while running() and task.wait(2) do
            local staff = next(staffHere)
            if staff and getgenv().StaffDetector ~= false and not getgenv().IsHopping then
